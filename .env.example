# ==========================================
# CONFIGURATION OUMI (أمي)
# ==========================================

# Base de données (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://oumi_user:oumi_password@localhost:5432/oumi_db
POSTGRES_USER=oumi_user
POSTGRES_PASSWORD=oumi_password
POSTGRES_DB=oumi_db
POSTGRES_PORT=5432

# API & Sécurité
JWT_SECRET=changez-cette-valeur-pour-la-production-aleatoire-123
JWT_REFRESH_SECRET=changez-cette-valeur-pour-la-production-aleatoire-456
API_PORT=3000
NODE_ENV=development

# Cartographie (OpenStreetMap / Mapbox / Google Maps)
MAP_API_KEY=votre_cle_api_cartographie_ici

# Notifications & Email (Firebase / SMTP)
FIREBASE_PROJECT_ID=votre_projet_firebase
FIREBASE_CLIENT_EMAIL=votre-email@votre-projet.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nVOTRE_CLE_PRIVEE_ICI\n-----END PRIVATE KEY-----\n"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=votre_utilisateur_smtp
SMTP_PASSWORD=votre_mot_de_passe_smtp

# Redis (Cache et notifications temps réel)
REDIS_URL=redis://localhost:6379
