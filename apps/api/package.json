{
    "name": "@oumi/api",
    "version": "1.0.0",
    "description": "OUMI API",
    "private": true,
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "test": "jest",
        "seed:wilayas": "ts-node -r tsconfig-paths/register src/seeds/seed-wilayas.ts",
        "migrate": "node dist/migrate.js",
        "start:prod": "npm run migrate && node dist/seeds/seed-wilayas.js && node dist/seeds/seed-health-facilities.js && node dist/main"
    },
    "dependencies": {
        "@nestjs/common": "^10.0.0",
        "@nestjs/config": "^3.0.0",
        "@nestjs/core": "^10.0.0",
        "@nestjs/jwt": "^10.0.0",
        "@nestjs/passport": "^10.0.0",
        "@nestjs/platform-express": "^10.0.0",
        "@nestjs/typeorm": "^10.0.0",
        "bcrypt": "^5.1.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "passport": "^0.6.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.11.0",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.1",
        "typeorm": "^0.3.17",
        "@types/bcrypt": "^5.0.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.0.0",
        "@nestjs/schematics": "^10.0.0",
        "@nestjs/testing": "^10.0.0",
        "@types/express": "^4.17.17",
        "@types/node": "^20.3.1",
        "@types/passport-jwt": "^3.0.9",
        "ts-loader": "^9.4.3",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.1.3",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.2",
        "@types/jest": "^29.5.12"
    },
    "jest": {
        "moduleFileExtensions": ["js", "json", "ts"],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": { "^.+\\.(t|j)s$": "ts-jest" },
        "collectCoverageFrom": ["**/*.(t|j)s"],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
